{
  "mcpServers": {
    "wufan_workstation": {
      "command": "./scripts/launch_wufan_workstation_mcp",
      "args": [
        "./server/index.mjs"
      ],
      "cwd": ".",
      "enabled": true,
      "required": true,
      "env_vars": [
        "WUFAN_WORKSTATION_BASE_URL",
        "WUFAN_WORKSTATION_TOKEN",
        "WUFAN_WORKSTATION_TOKEN_FILE",
        "WUFAN_WORKSTATION_CONFIG_DIR",
        "CODEX_MCP_NODE_PATH",
        "CODEX_BROWSER_USE_NODE_PATH",
        "CODEX_ELECTRON_RESOURCES_PATH",
        "CODEX_CLI_PATH",
        "XDG_CACHE_HOME",
        "HOME",
        "USERPROFILE",
        "LOCALAPPDATA",
        "PATH"
      ],
      "startup_timeout_sec": 15,
      "tool_timeout_sec": 60,
      "default_tools_approval_mode": "auto"
    }
  }
}
