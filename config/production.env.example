# Choose one server profile and copy it into the server's protected environment.
# This file contains paths and placeholders only. Never store passwords, JWTs,
# auth.secret contents, WDT_KEY, WDT_SALT or other credentials in Git.

# New Mac mini profile (wufan001)
WUFAN_PROJECT_DIR=/Users/wufan001/Projects/goal-execution-system
WUFAN_DATA_ROOT=/Users/wufan001/WufanWorkstationData/production
WUFAN_DB_PATH=/Users/wufan001/WufanWorkstationData/production/workstation.db
WUFAN_DB_BASELINE_PATH=/Users/wufan001/WufanWorkstationData/production/business-baseline.json
WUFAN_UPLOADS_PATH=/Users/wufan001/WufanWorkstationData/production/uploads
WUFAN_AUTH_SECRET_PATH=/Users/wufan001/WufanWorkstationData/production/auth.secret
WUFAN_RELEASE_ROOT=/Users/wufan001/WufanWorkstationReleases
WUFAN_BACKUP_ROOT=/Users/wufan001/WufanWorkstationBackups
WUFAN_PM2_LOG_ROOT=/Users/wufan001/.pm2/logs
WUFAN_NODE_COMMAND=/usr/local/bin/node
WUFAN_NPM_COMMAND=/usr/local/bin/npm

# Existing MacBook Air profile (replace the active values above when needed)
# WUFAN_PROJECT_DIR=/Users/meiyounaichatouyuna/Projects/goal-execution-system
# WUFAN_DATA_ROOT=/Users/meiyounaichatouyuna/WufanWorkstationData/production
# WUFAN_DB_PATH=/Users/meiyounaichatouyuna/WufanWorkstationData/production/workstation.db
# WUFAN_DB_BASELINE_PATH=/Users/meiyounaichatouyuna/WufanWorkstationData/production/business-baseline.json
# WUFAN_UPLOADS_PATH=/Users/meiyounaichatouyuna/WufanWorkstationData/production/uploads
