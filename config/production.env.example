# WUFAN_PM2_LOG_ROOT=/Users/meiyounaichatouyuna/.pm2/logs

# Runtime settings remain inherited from the protected server environment.
WUFAN_ENV=production
WUFAN_BACKGROUND_JOBS=on
HOST=0.0.0.0
PORT=3001
# For a Mac mini rehearsal copy only, set WUFAN_BACKGROUND_JOBS=off to prevent
# queue recovery, scheduled syncs, task-wave collection and other startup jobs.
# WDT_API_URL=
# WDT_SID=
# WDT_KEY=
# WDT_SALT=
